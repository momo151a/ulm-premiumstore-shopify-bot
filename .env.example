SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ベンダーマスタ（Google Sheets）
GOOGLE_SHEETS_ID=
# サービスアカウント JSON キーのファイルパス
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/service-account.json

# 発送報告フォーム（Google Form）
GOOGLE_FORM_URL=
